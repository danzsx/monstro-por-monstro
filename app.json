{
  "expo": {
    "name": "Monstro por Monstro",
    "slug": "monstro-por-monstro",
    "scheme": "monstropormonstro",
    "experiments": { "typedRoutes": true },
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/monsters/proportions.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monstropormonstro.app"
    },
    "android": {
      "package": "com.monstropormonstro.app",
      "adaptiveIcon": { "backgroundColor": "#F5E1D3", "foregroundImage": "./assets/monsters/proportions.png" },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/monsters/proportions.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
